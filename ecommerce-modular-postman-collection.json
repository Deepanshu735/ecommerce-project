{
  "info": {
    "name": "Express Ecommerce Modular",
    "_postman_id": "8f42d1c6-7b90-4e13-a55c-ecom6modular000",
    "description": "Modular feature-based ecommerce - Products / Cart / Wishlist CRUD. Server: pnpm dev (port 3500). Data in-memory hai, restart karte hi reset. Seed products ki id 1-4 hain, uske baad cart/wishlist items ko ids milti hain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3500" },
    { "key": "productId", "value": "1" },
    { "key": "cartItemId", "value": "5" },
    { "key": "wishlistItemId", "value": "6" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Stand\",\n  \"price\": 1299,\n  \"stock\": 20\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Create Product - Validation Fail (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"price\": \"bahut mehnga\"\n}" },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 699,\n  \"stock\": 50\n}" },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
          }
        },
        {
          "name": "Get Cart Item By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "{{cartItemId}}"]
            }
          }
        },
        {
          "name": "Add To Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"1\",\n  \"qty\": 2\n}" },
            "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
          }
        },
        {
          "name": "Update Cart Qty",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"qty\": 5\n}" },
            "url": {
              "raw": "{{baseUrl}}/cart/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "{{cartItemId}}"]
            }
          }
        },
        {
          "name": "Delete Cart Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "{{cartItemId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Wishlist",
      "item": [
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/wishlist", "host": ["{{baseUrl}}"], "path": ["wishlist"] }
          }
        },
        {
          "name": "Get Wishlist Item By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{wishlistItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{wishlistItemId}}"]
            }
          }
        },
        {
          "name": "Add To Wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"3\"\n}" },
            "url": { "raw": "{{baseUrl}}/wishlist", "host": ["{{baseUrl}}"], "path": ["wishlist"] }
          }
        },
        {
          "name": "Update Wishlist Item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"4\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{wishlistItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{wishlistItemId}}"]
            }
          }
        },
        {
          "name": "Delete Wishlist Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{wishlistItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{wishlistItemId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Unknown Route (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
      }
    }
  ]
}
